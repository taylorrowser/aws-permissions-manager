{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "apm: agents request scoped AWS permissions; the owner approves them",
  "Outputs": {
    "Url": {
      "Value": "https://apm.taylorrowser.com"
    }
  },
  "Resources": {
    "Api": {
      "Properties": {
        "DisableExecuteApiEndpoint": true,
        "Name": "apm",
        "ProtocolType": "HTTP"
      },
      "Type": "AWS::ApiGatewayV2::Api"
    },
    "Boundary": {
      "Properties": {
        "Description": "apm: maximum permissions for any agent role",
        "ManagedPolicyName": "apm-agent-boundary",
        "PolicyDocument": {
          "Statement": [
            {
              "Effect": "Allow",
              "NotAction": [
                "iam:*",
                "organizations:*",
                "account:*",
                "sso:*",
                "sso-directory:*",
                "identitystore:*",
                "aws-portal:*",
                "billing:*",
                "payments:*",
                "tax:*",
                "cur:*",
                "sts:AssumeRole",
                "sts:AssumeRoleWithSAML",
                "sts:AssumeRoleWithWebIdentity"
              ],
              "Resource": "*",
              "Sid": "AllowNonAdminServices"
            },
            {
              "Action": [
                "iam:Get*",
                "iam:List*"
              ],
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "AllowIamRead"
            },
            {
              "Action": "iam:PassRole",
              "Effect": "Allow",
              "Resource": "arn:aws:iam::654654478411:role/agents/*",
              "Sid": "AllowPassAgentRoles"
            }
          ],
          "Version": "2012-10-17"
        }
      },
      "Type": "AWS::IAM::ManagedPolicy"
    },
    "BrokerRole": {
      "DependsOn": "Boundary",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "Description": "apm broker: the Lambda that creates agent roles and vends their credentials",
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Path": "/apm/",
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "iam:CreateRole",
                  "Condition": {
                    "StringEquals": {
                      "iam:PermissionsBoundary": "arn:aws:iam::654654478411:policy/apm-agent-boundary"
                    }
                  },
                  "Effect": "Allow",
                  "Resource": "arn:aws:iam::654654478411:role/agents/*",
                  "Sid": "CreateAgentRolesWithBoundary"
                },
                {
                  "Action": [
                    "iam:GetRole",
                    "iam:TagRole",
                    "iam:DeleteRole",
                    "iam:ListRolePolicies",
                    "iam:GetRolePolicy",
                    "iam:PutRolePolicy",
                    "iam:DeleteRolePolicy",
                    "iam:ListAttachedRolePolicies"
                  ],
                  "Effect": "Allow",
                  "Resource": "arn:aws:iam::654654478411:role/agents/*",
                  "Sid": "EditAgentRoles"
                },
                {
                  "Action": "sts:AssumeRole",
                  "Effect": "Allow",
                  "Resource": "arn:aws:iam::654654478411:role/agents/*",
                  "Sid": "VendAgentCredentials"
                },
                {
                  "Action": [
                    "iam:GetRole",
                    "iam:GetRolePolicy",
                    "iam:ListRolePolicies"
                  ],
                  "Effect": "Allow",
                  "Resource": "arn:aws:iam::654654478411:role/apm-*",
                  "Sid": "LookUpAgentRoles"
                },
                {
                  "Action": [
                    "iam:DeleteRolePermissionsBoundary",
                    "iam:PutRolePermissionsBoundary"
                  ],
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "NeverRemoveBoundary"
                },
                {
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Scan"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Table",
                      "Arn"
                    ]
                  },
                  "Sid": "State"
                },
                {
                  "Action": "ssm:GetParameter",
                  "Effect": "Allow",
                  "Resource": "arn:aws:ssm:us-east-1:654654478411:parameter/apm/*",
                  "Sid": "Secrets"
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "apm-broker"
          }
        ],
        "RoleName": "apm-broker"
      },
      "Type": "AWS::IAM::Role"
    },
    "Certificate": {
      "Properties": {
        "DomainName": "apm.taylorrowser.com",
        "DomainValidationOptions": [
          {
            "DomainName": "apm.taylorrowser.com",
            "HostedZoneId": "Z0EXAMPLE"
          }
        ],
        "ValidationMethod": "DNS"
      },
      "Type": "AWS::CertificateManager::Certificate"
    },
    "Dns": {
      "Properties": {
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "DomainName",
              "RegionalDomainName"
            ]
          },
          "HostedZoneId": {
            "Fn::GetAtt": [
              "DomainName",
              "RegionalHostedZoneId"
            ]
          }
        },
        "HostedZoneId": "Z0EXAMPLE",
        "Name": "apm.taylorrowser.com",
        "Type": "A"
      },
      "Type": "AWS::Route53::RecordSet"
    },
    "DomainName": {
      "Properties": {
        "DomainName": "apm.taylorrowser.com",
        "DomainNameConfigurations": [
          {
            "CertificateArn": {
              "Ref": "Certificate"
            },
            "EndpointType": "REGIONAL",
            "SecurityPolicy": "TLS_1_2"
          }
        ]
      },
      "Type": "AWS::ApiGatewayV2::DomainName"
    },
    "Function": {
      "DependsOn": "Logs",
      "Properties": {
        "Architectures": [
          "arm64"
        ],
        "Code": {
          "S3Bucket": "apm-artifacts-654654478411-us-east-1",
          "S3Key": "lambda/0123456789abcdef.zip"
        },
        "Environment": {
          "Variables": {
            "DOMAIN": "apm.taylorrowser.com",
            "OWNER_EMAILS": "owner@example.com",
            "PARAM_PREFIX": "/apm",
            "TABLE_NAME": "apm",
            "VAPID_PUBLIC_KEY": "VAPIDPUB",
            "WORKOS_CLIENT_ID": "client_EXAMPLE"
          }
        },
        "FunctionName": "apm",
        "Handler": "apm.web.handler",
        "MemorySize": 512,
        "Role": {
          "Fn::GetAtt": [
            "BrokerRole",
            "Arn"
          ]
        },
        "Runtime": "python3.13",
        "Timeout": 29
      },
      "Type": "AWS::Lambda::Function"
    },
    "Integration": {
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "Function",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0"
      },
      "Type": "AWS::ApiGatewayV2::Integration"
    },
    "InvokePermission": {
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/*"
        }
      },
      "Type": "AWS::Lambda::Permission"
    },
    "Logs": {
      "Properties": {
        "LogGroupName": "/aws/lambda/apm",
        "RetentionInDays": 90
      },
      "Type": "AWS::Logs::LogGroup"
    },
    "Mapping": {
      "DependsOn": [
        "DomainName",
        "Stage"
      ],
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "DomainName": "apm.taylorrowser.com",
        "Stage": "$default"
      },
      "Type": "AWS::ApiGatewayV2::ApiMapping"
    },
    "Route": {
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        }
      },
      "Type": "AWS::ApiGatewayV2::Route"
    },
    "Stage": {
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 50,
          "ThrottlingRateLimit": 20
        },
        "StageName": "$default"
      },
      "Type": "AWS::ApiGatewayV2::Stage"
    },
    "Table": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "TableName": "apm"
      },
      "Type": "AWS::DynamoDB::Table",
      "UpdateReplacePolicy": "Retain"
    }
  }
}
